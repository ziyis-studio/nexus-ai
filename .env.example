# Server-only values. Never commit .env. Supabase CLI status provides local keys.
ENVIRONMENT=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Optional internal addresses when API runs in Docker, while issuer remains public.
SUPABASE_AUTH_URL=
SUPABASE_REST_URL=
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated
JWT_ALGORITHMS=["ES256","RS256"]
# Local Supabase legacy HS256 only: explicitly add HS256 above and set this key.
JWT_SECRET=
VERIFY_SESSION=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=
LLM_TIMEOUT=30
LLM_MAX_OUTPUT_TOKENS=2200
MAX_ATTEMPTS=3
JOB_DEADLINE=180
LEASE_SECONDS=240
WORKER_CONCURRENCY=2
# These three values are intentionally public and baked into the web build.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Provisioning script only. Keep server-side; never prefix with NUXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
